POSTGRES_DB=anonytix
POSTGRES_USER=anonytix
POSTGRES_PASSWORD=anonytix
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/anonytix
DB_USERNAME=anonytix
DB_PASSWORD=anonytix
FRONTEND_URL=https://anonytix.app
CORS_ORIGINS=http://localhost:5173,https://anonytix.app

# Docker aktiviert das OpenAI-Profil standardmäßig.
# Bei lokalem Maven-Start zusätzlich SPRING_PROFILES_ACTIVE=openai setzen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_COMPLETION_TOKENS=1200
OPENAI_RETRY_MAX_ATTEMPTS=3
